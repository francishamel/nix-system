{
  "$schema": "https://raw.githubusercontent.com/wynainfo/pi-permission-modes/v2.2.0/schemas/permission-mode.schema.json",
  "defaultMode": "guarded",
  "cycleOrder": ["guarded"],
  "modes": {
    "guarded": {
      "label": "Guarded",
      "color": "mdLink",
      "sandbox": {
        "enabled": true,
        "writable": true,
        "allowWrite": [".", "/tmp"],
        "denyWrite": [],
        "denyRead": [
          "~/.ssh",
          "~/.aws",
          "~/.config/gcloud",
          "~/.gnupg",
          "~/.pi",
          "~/.config/op",
          "~/.config/1Password"
        ],
        "network": {
          "allowedDomains": [],
          "deniedDomains": []
        }
      },
      "permission": {
        "path": {
          "*": "ask",
          "*.env": "deny",
          "*.env.*": "deny",
          "*/.env": "deny",
          "*/.env.*": "deny",
          "*.pem": "deny",
          "*/id_rsa*": "deny",
          "*/id_ed25519*": "deny",
          "*/.ssh": "deny",
          "*/.ssh/*": "deny",
          "*/.aws": "deny",
          "*/.aws/*": "deny",
          "*/.config/gcloud": "deny",
          "*/.config/gcloud/*": "deny",
          "*/.gnupg": "deny",
          "*/.gnupg/*": "deny",
          "*/.pi": "deny",
          "*/.pi/*": "deny",
          "*/.config/op": "deny",
          "*/.config/op/*": "deny",
          "*/.config/1Password": "deny",
          "*/.config/1Password/*": "deny"
        },
        "external_directory": "ask",
        "read": "ask",
        "grep": "ask",
        "find": "ask",
        "ls": "ask",
        "write": "ask",
        "edit": "ask",
        "bash": {
          "*": "ask"
        },
        "web_search": "ask",
        "tool": "ask",
        "skill": "ask"
      }
    }
  }
}
